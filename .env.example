# =============================================================================
# HECTRON AUTÓNOMO v3.2 - Configuración Completa
# =============================================================================
# Copia este archivo a .env y completa las variables
# NUNCA subas el archivo .env a GitHub

# =============================================================================
# CONFIGURACIÓN BÁSICA
# =============================================================================

# Puerto del servidor principal (API + Dashboard)
PORT=3000

# Puerto del servidor de autonomía
AUTONOMY_PORT=3001

# Token de autenticación para el Local Agent
# Genera uno aleatorio: openssl rand -hex 64
AGENT_TOKEN=tu_token_secreto_largo_y_aleatorio_128_caracteres

# Entorno
NODE_ENV=development

# CORS - En producción, cambia * por tu dominio
CORS_ORIGIN=*


# =============================================================================
# PRISM LIVE STUDIO (GAMES & IRL) - VERSIÓN WEB
# =============================================================================

# PRISM se controla automatizando su interfaz web con Playwright.
# URL donde se abre PRISM Live Studio en el navegador.
PRISM_URL=https://prismlive.com

# Perfil/directorio de usuario del navegador Chromium (para mantener sesión iniciada).
# Vacío = navegador efímero. Ej: /home/usuario/.prism-profile
PRISM_PROFILE=

# Ejecutar el navegador en modo headless (sin ventana visible). false = ver el navegador.
PRISM_HEADLESS=false

# Timeout de navegación en ms (espera a que aparezcan elementos de la UI).
PRISM_NAV_TIMEOUT=60000


# =============================================================================
# STREAMING (TikTok LIVE)
# =============================================================================

# Servidor RTMP de TikTok
STREAM_SERVER=rtmp://live.tiktok.com/push/
STREAM_KEY=tu_stream_key_de_tiktok


# =============================================================================
# API EXTERNAS - GEMINI (Google AI Studio)
# =============================================================================

# Clave de API de Google Gemini
# Obtén una en: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...


# =============================================================================
# API EXTERNAS - ELEVENLABS (TTS)
# =============================================================================

# Clave de API de ElevenLabs (opcional, para voz más realista)
ELEVENLABS_API_KEY=tu_clave_elevenlabs


# =============================================================================
# TIKTOK API (Para chat en tiempo real)
# =============================================================================

# Credenciales de la aplicación TikTok
# Registra tu app en: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=tu_client_key
TIKTOK_CLIENT_SECRET=tu_client_secret
TIKTOK_REDIRECT_URI=https://hectron-3d-stream-studio.ai.studio/auth/tiktok


# =============================================================================
# BIGQUERY (Google Cloud Platform)
# =============================================================================

# ID del proyecto de Google Cloud
GCP_PROJECT_ID=tu-proyecto-gcp

# Credenciales de servicio de Google Cloud (JSON)
# Genera una clave de servicio en: https://console.cloud.google.com/iam-admin/serviceaccounts
# y pega el contenido JSON aquí (entre comillas simples)
GCP_CREDENTIALS_JSON='{
  "type": "service_account",
  "project_id": "tu-proyecto-gcp",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "hectron@tu-proyecto-gcp.iam.gserviceaccount.com",
  "client_id": "...",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/hectron%40tu-proyecto-gcp.iam.gserviceaccount.com"
}'

# Dataset de BigQuery (por defecto: hectron_autonomo)
BIGQUERY_DATASET=hectron_autonomo


# =============================================================================
# GITHUB (Para CI/CD)
# =============================================================================

# Token de GitHub (para GitHub Actions)
# Genera uno en: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_

# Propietario y nombre del repositorio
GITHUB_REPO_OWNER=Hectron-lands
GITHUB_REPO_NAME=HectronAutonomo

# Webhook secret (opcional)
GITHUB_WEBHOOK_SECRET=tu_webhook_secret


# =============================================================================
# VERCEL (Para despliegue)
# =============================================================================

# Token de API de Vercel
# Genera uno en: https://vercel.com/account/tokens
VERCEL_TOKEN=vc_

# ID del proyecto en Vercel
VERCEL_PROJECT_ID=prj_

# ID del equipo en Vercel
VERCEL_TEAM_ID=team_


# =============================================================================
# CONFIGURACIÓN DE AUTONOMÍA
# =============================================================================

# Umbral de inactividad para activar autonomía (en milisegundos)
# Default: 120000 = 2 minutos
AUTONOMOUS_THRESHOLD_MS=120000

# Escenas disponibles para autonomía (separadas por comas)
AUTONOMOUS_SCENES=HAPPY_SCENE,SAD_SCENE,ANGRY_SCENE,SURPRISE_SCENE,FLIRT_SCENE,DEFAULT

# URL del servidor de autonomía (para el Local Agent)
AUTONOMY_SERVER_URL=http://localhost:3001


# =============================================================================
# CONFIGURACIÓN DEL CEREBRO
# =============================================================================

# URL del WebSocket del cerebro
BRAIN_WS_URL=ws://localhost:3000/api/brain/ws


# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. NUNCA subas el archivo .env a GitHub
# 2. Para producción, usa variables de entorno en tu plataforma (Vercel, etc.)
# 3. Las credenciales de GCP deben tener permisos de BigQuery Data Editor
# 4. El token de GitHub debe tener permisos de repo y workflow
# 5. El token de Vercel debe tener permisos de despliegue