# Puerto del agente local
PORT=8787

# Token de autenticación
AGENT_TOKEN=tu_token_secreto_largo_y_aleatorio

# Configuración de PRISM Live Studio (Games & IRL) - versión web (Playwright)
# URL donde se abre PRISM en el navegador
PRISM_URL=https://prismlive.com
# Perfil de Chromium para mantener sesión (vacío = efímero)
PRISM_PROFILE=
# Navegador sin ventana visible (false = ver el navegador)
PRISM_HEADLESS=false
# Timeout de navegación (ms)
PRISM_NAV_TIMEOUT=60000

# Configuración de RTMP (opcional)
STREAM_SERVER=rtmp://live.tiktok.com/push/
STREAM_KEY=tu_stream_key

# CORS (en producción, cambia * por tu dominio)
CORS_ORIGIN=*

# URL del cerebro (para WebSocket)
BRAIN_WS_URL=ws://127.0.0.1:3000/api/brain/ws