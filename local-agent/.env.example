# Puerto del agente local
PORT=8787

# Token de autenticación
AGENT_TOKEN=tu_token_secreto_largo_y_aleatorio

# Configuración de PRISM Live Studio (Games & IRL) - app de escritorio Qt (pywinauto)
# Título de la ventana de PRISM (coincidencia parcial)
PRISM_WINDOW_TITLE=PRISM Live Studio
# Ejecutable de Python para el bridge
PRISM_PYTHON=python
# Comando para lanzar PRISM (vacío = no lanzar automáticamente)
PRISM_LAUNCH_CMD=
# Timeout de lanzamiento (ms)
PRISM_LAUNCH_TIMEOUT=30000

# Configuración de RTMP (opcional)
STREAM_SERVER=rtmp://live.tiktok.com/push/
STREAM_KEY=tu_stream_key

# CORS (en producción, cambia * por tu dominio)
CORS_ORIGIN=*

# URL del cerebro (para WebSocket)
BRAIN_WS_URL=ws://127.0.0.1:3000/api/brain/ws