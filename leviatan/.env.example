# ─── LEVIATÁN — Configuración ────────────────────────────────────────────────
# Copia este archivo a .env (en la raíz del repo) y rellena tus claves.

# GOOGLE AI STUDIO (Gemini) — GRATIS: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# TIKTOK LIVE — usuario SIN la @
TIKTOK_USERNAME=lopez_hector140998

# ELEVENLABS (TTS) — gratis: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obbfDQGcgMyIGb
ELEVENLABS_MODEL=eleven_multilingual_v2

# VSEEFACE / OSC (cuerpo 3D)
OSC_HOST=127.0.0.1
OSC_PORT=39000

# AGENTE LOCAL (Node.js) — control de PRISM Live Studio
# El Leviatán envía la emoción al agente para cambiar la escena de PRISM.
# Vacío en AGENT_URL = desactivado (el Leviatán funciona igual sin PRISM).
AGENT_URL=http://localhost:8787
AGENT_TOKEN=

# Mapeo emociones → escenas (opcional, sobreescribe los defaults)
# SCENE_JOY=MI_ESCENA_FELIZ
# SCENE_ANGRY=MI_ESCENA_FURIOSA
# SCENE_Sorrow=MI_ESCENA_TRISTE
# SCENE_Fun=MI_ESCENA_DIVERTIDA
# SCENE_Neutral=MI_ESCENA_BASE

# AUDIO — reproducir voz por altavoces (true/false)
REPRODUCIR_AUDIO=true
